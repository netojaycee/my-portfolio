# Neon DB
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# NextAuth v5
BETTER_SECRET=
URL=http://localhost:3000

# Admin user (single user — store bcrypt hash, not plain password)
# Generate/reset with: pnpm admin:hash "yourpassword"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Google Analytics 4 — Measurement ID from analytics.google.com (e.g. G-XXXXXXXXXX)
# Leave blank to disable; Vercel Analytics works with zero config on Vercel deployments.
NEXT_PUBLIC_GA_ID=

# Search engine ownership verification (optional)
# Google Search Console: Settings > Ownership verification > HTML tag > copy the "content" value only
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: Settings > Ownership verification > HTML Meta Tag > copy the "content" value only
BING_SITE_VERIFICATION=
